# Raw inputs never move between laptops — outputs move instead (Master §7)
data/*
!data/.gitkeep
# ...except the labelled training table, which is small and IS a deliverable
# (docs/02_SOUM_DETECTION.md: "features.csv committed (hundreds of rows)")
!data/labels/
data/labels/*
!data/labels/features.csv

# Environments
venv/
.venv/
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Big raw formats — nothing over ~20 MB belongs in this repo
*.tif
*.tiff
# ...except the case bundle's 2-band SAR GeoTIFF: Stage 1 reads it from cases/<id>/ and the
# no-imports architecture needs it to travel with the repo (~8-10 MB/case at 10 m, tight box).
!cases/*/sar_vv_vh.tif
*.7z
*.zip
*.npz
*.parquet
*.pkl.gz

# Intermediate stage outputs — regenerable, the bundle in cases/ is the artefact
pipeline/*/out/

# Throwaway end-to-end smoke / dry-run bundles (scripts/make_case000.py --scene-only)
cases/case-smoke/
cases/case-dry/

# Frontend build
web/.next/
web/dist/
web/public/cases/
# vendored maplibre worker + shared chunk, copied from node_modules by predev/prebuild
web/public/maplibre/

# Credentials — never, under any circumstances
.env
*.pem
.earthengine/
credentials.json

# Per-teammate handoff briefs — shared by hand (WhatsApp), never pushed
HANDOFF_*.md

# THE SEALED ANSWERS (Master Plan D21 / Part 16). Akshat holds this; nobody else sees it, and
# it must never reach a branch. docs/ANSWERS.README.md IS committed, so the team knows the
# file exists and who has it — hiding its existence would be worse than holding it.
docs/ANSWERS.md

# OS noise
.DS_Store
Thumbs.db
